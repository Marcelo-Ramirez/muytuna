// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  userName           String              @unique @default(cuid()) @map("userName")
  name               String
  phone              String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  statusAccount      String              @default("active") @map("statusAccount")
  role               String              @default("cliente")
  twoFactorSecret    String?             @map("twoFactorSecret")
  twoFactorEnabled   Boolean             @default(false) @map("twoFactorEnabled")
  userNameGenerated  Boolean             @default(false) @map("userNameGenerated")
  createdAt          DateTime            @default(now()) @map("createdAt")
  updatedAt          DateTime            @updatedAt @map("updatedAt")

  // Relaciones
  inventoryMovements InventoryMovement[]
  saleOrders         SaleOrder[]
  productMovements   ProductMovement[]
  saleProducts       SaleProduct[]
  accounts           Account[]
  sessions           Session[]

  @@map("Users")
}

model Account {
  id                 Int      @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationTokens")
}

model Ingredient {
  id                 Int                  @id @default(autoincrement())
  name               String
  unit               String
  pricePerUnit       Float                @map("pricePerUnit")
  provider           String
  currentQuantity    Float                @map("currentQuantity")
  createdAt          DateTime             @default(now()) @map("createdAt")
  updatedAt          DateTime             @updatedAt @map("updatedAt")

  // Relaciones
  inventoryMovements InventoryMovement[]
  ingredientEOQ      IngredientEOQModel?

  @@map("Ingredients")
}

model IngredientEOQModel {
  id                    Int      @id @default(autoincrement())
  idIngredient          Int      @unique @map("id_Ingredient")
  orderingCost          Float    @map("orderingCost")
  annualMaintenanceCost Float    @map("annualMaintenanceCost")
  leadTimeDays          Float    @map("leadTimeDays")
  dailyDemand           Float    @map("dailyDemand")
  annualDemand          Float    @map("annualDemand")
  reorderPoint          Float    @map("reorderPoint")
  updatedAt             DateTime @updatedAt @map("updatedAt")

  // Relación
  ingredient Ingredient @relation(fields: [idIngredient], references: [id], onDelete: Cascade)

  @@map("Ingredients_EOQ_model")
}

model InventoryMovement {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  ingredientId Int      @map("ingredient_id")
  movementType String   @map("movementType")
  reason       String
  quantity     Float
  createdAt    DateTime @default(now()) @map("createdAt")

  // Relaciones
  user         User     @relation(fields: [userId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("Inventory_movements")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  flavor          String
  type            String
  imageUrl        String   @map("imageUrl")
  pricePerUnit    Float    @map("pricePerUnit")
  currentQuantity Float    @map("currentQuantity")
  
  // Campos de código de barras
  sku             String?  @unique
  barcode         String?  @unique
  barcodeFormat   String?  @default("CODE128")
  lastSequenceNumber Int     @default(0) @map("last_sequence_number")
  
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")
  
  // Relaciones
  orderClients    OrderClient[]
  saleProducts    SaleProduct[]
  productMovements ProductMovement[]
  batches         ProductBatch[]

  @@map("Products")
}

model OrderClient {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  productId   Int      @map("product_id")
  quantity    Float
  status      String
  createdAt   DateTime @default(now()) @map("createdAt")
  saleOrder   SaleOrder?

  // Relaciones
  product Product @relation(fields: [productId], references: [id])

  @@map("Order_clients")
}

model SaleOrder {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  orderClientId  Int      @unique @map("order_client_id")
  totalCostOrder Float    @map("totalCostOrder")
  createdAt      DateTime @default(now()) @map("createdAt")
  saleProducts   SaleProduct[]

  // Relaciones
  user User @relation(fields: [userId], references: [id])
  orderClient OrderClient @relation(fields: [orderClientId], references: [id])

  @@map("Sale_orders")
}

model SaleProduct {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Float
  createdAt DateTime @default(now()) @map("createdAt")
  saleOrderId Int    @map("sale_order_id")

  // Relaciones
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id])

  @@map("Sale_products")
}

model ProductMovement {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  productId     Int      @map("product_id")
  batchId       Int?     @map("batch_id")
  movementType  String   @map("movement_type") // INGRESO, EGRESO, AJUSTE
  quantity      Float
  notes         String?  // Notas adicionales
  createdAt     DateTime @default(now()) @map("createdAt")

  // Relaciones
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  batch     ProductBatch? @relation(fields: [batchId], references: [id])
  
  @@index([productId])
  @@index([batchId])
  @@map("Product_movements")
}

model ProductBatch {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  batchNumber     String   @unique @map("batch_number")
  barcode         String?  @unique
  
  initialQuantity Float    
  remaining       Float    
  status          String   @default("ACTIVE")
  
  productionDate  DateTime @default(now()) @map("production_date")
  expiryDate      DateTime? @map("expiry_date")
  updatedAt       DateTime @updatedAt @map("updated_at") 
  notes           String?
  
  // Relación
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productMovements ProductMovement[]
  
  @@index([productId, expiryDate])
  @@index([productId, remaining])
  @@map("Product_batches")
}
