// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  userName           String              @unique @default(cuid()) @map("userName")
  name               String
  phone              String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  statusAccount      String              @default("active") @map("statusAccount")
  role               String              @default("cliente")
  twoFactorSecret    String?             @map("twoFactorSecret")
  twoFactorEnabled   Boolean             @default(false) @map("twoFactorEnabled")
  userNameGenerated  Boolean             @default(false) @map("userNameGenerated")
  createdAt          DateTime            @default(now()) @map("createdAt")
  updatedAt          DateTime            @updatedAt @map("updatedAt")

  // Relaciones
  inventoryMovements InventoryMovement[]
  productMovements   ProductMovement[]
  accounts           Account[]
  sessions           Session[]
  orders             Order[]

  @@map("Users")
}

model Account {
  id                 Int      @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationTokens")
}

model Ingredient {
  id                 Int                  @id @default(autoincrement())
  name               String
  unit               String
  pricePerUnit       Float                @map("pricePerUnit")
  provider           String
  currentQuantity    Float                @map("currentQuantity")
  createdAt          DateTime             @default(now()) @map("createdAt")
  updatedAt          DateTime             @updatedAt @map("updatedAt")

  // Relaciones
  inventoryMovements InventoryMovement[]
  ingredientEOQ      IngredientEOQModel?

  @@map("Ingredients")
}

model IngredientEOQModel {
  id                    Int      @id @default(autoincrement())
  idIngredient          Int      @unique @map("id_Ingredient")
  orderingCost          Float    @map("orderingCost")
  annualMaintenanceCost Float    @map("annualMaintenanceCost")
  leadTimeDays          Float    @map("leadTimeDays")
  dailyDemand           Float    @map("dailyDemand")
  annualDemand          Float    @map("annualDemand")
  reorderPoint          Float    @map("reorderPoint")
  updatedAt             DateTime @updatedAt @map("updatedAt")

  // Relación
  ingredient Ingredient @relation(fields: [idIngredient], references: [id], onDelete: Cascade)

  @@map("Ingredients_EOQ_model")
}

model InventoryMovement {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  ingredientId Int      @map("ingredient_id")
  movementType String   @map("movementType")
  reason       String
  quantity     Float
  createdAt    DateTime @default(now()) @map("createdAt")

  // Relaciones
  user         User     @relation(fields: [userId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("Inventory_movements")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  flavor          String
  type            String
  imageUrl        String   @map("imageUrl")
  pricePerUnit    Float    @map("pricePerUnit")
  currentQuantity Float    @map("currentQuantity")
  
  // Campos de código de barras
  sku             String?  @unique
  barcode         String?  @unique
  barcodeFormat   String?  @default("CODE128")
  lastSequenceNumber Int     @default(0) @map("last_sequence_number")
  
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")
  
  // Relaciones
  orderItems      OrderItem[]
  productMovements ProductMovement[]
  batches         ProductBatch[]

  @@map("Products")
}

// ============================================
// PEDIDOS / VENTAS (estructura simplificada)
// ============================================

model Order {
  id          Int         @id @default(autoincrement())
  
  // Usuario opcional: null = venta en persona, valor = venta online
  userId      Int?        @map("user_id")
  
  // Canal y estado
  channel     String      @default("IN_PERSON")  // IN_PERSON | ONLINE
  status      String      @default("pending")    // pending | paid | completed | cancelled
  
  // Información de contacto y envío (para pedidos online)
  contactPhone    String?     @map("contact_phone")
  shippingAddress String?     @map("shipping_address")
  paymentMethod   String?     @map("payment_method")  // QR | CASH | TRANSFER
  payerName       String?     @map("payer_name")      // Nombre de la persona que realizará el pago
  
  // Costos
  subtotal    Float       @default(0)
  shippingCost Float      @default(0) @map("shipping_cost")
  taxAmount   Float       @default(0) @map("tax_amount")
  totalAmount Float       @default(0) @map("total_amount")
  
  // Número de orden para mostrar al cliente
  orderNumber String?     @unique @map("order_number")
  
  // Timestamps
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  paidAt      DateTime?   @map("paid_at")
  
  // Relaciones
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@map("Orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")
  
  quantity    Float
  unitPrice   Float    @map("unit_price")    // Precio al momento de la compra (snapshot)
  subtotal    Float                          // quantity * unitPrice
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relaciones
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  
  @@index([orderId])
  @@index([productId])
  @@map("Order_items")
}

model ProductMovement {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  productId     Int      @map("product_id")
  batchId       Int?     @map("batch_id")
  movementType  String   @map("movement_type") // INGRESO, EGRESO, AJUSTE
  quantity      Float
  notes         String?  // Notas adicionales
  createdAt     DateTime @default(now()) @map("createdAt")

  // Relaciones
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  batch     ProductBatch? @relation(fields: [batchId], references: [id])
  
  @@index([productId])
  @@index([batchId])
  @@map("Product_movements")
}

model ProductBatch {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  batchNumber     String   @unique @map("batch_number")
  barcode         String?  @unique
  
  initialQuantity Float    
  remaining       Float    
  status          String   @default("ACTIVE")
  
  productionDate  DateTime @default(now()) @map("production_date")
  expiryDate      DateTime? @map("expiry_date")
  updatedAt       DateTime @updatedAt @map("updated_at") 
  notes           String?
  
  // Relación
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productMovements ProductMovement[]
  
  @@index([productId, expiryDate])
  @@index([productId, remaining])
  @@map("Product_batches")
}
